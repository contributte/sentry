includes:
	- vendor/contributte/phpstan/phpstan.neon

parameters:
	level: 9
	phpVersion: 80200

	scanDirectories:
		- src

	fileExtensions:
		- php

	paths:
		- src
		- .docs

	ignoreErrors:
		- '#Call to method .+ of deprecated class Nette\\Security\\Identity#'
		- '#Parameter \#2 \$options of function curl_setopt_array expects#'
